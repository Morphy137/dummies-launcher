{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dummies",
  "version": "1.0.7",
  "identifier": "com.morphy137.dummies",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "Dummies",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#07080a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' blob: data: https://shared.fastly.steamstatic.com https://shared.akamai.steamstatic.com https://cdn.akamai.steamstatic.com https://cdn.discordapp.com https://cdn1.epicgames.com https://cdn2.unrealengine.com; connect-src ipc: http://ipc.localhost https://shared.fastly.steamstatic.com https://shared.akamai.steamstatic.com https://cdn.akamai.steamstatic.com https://cdn.discordapp.com https://cdn1.epicgames.com https://cdn2.unrealengine.com; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/dummy-game.exe": "resources/dummy-game.exe",
      "resources/DEPENDENCY_LICENSES.txt": "DEPENDENCY_LICENSES.txt",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3MjlEQjIyQTg5MjkyN0UKUldSK2twS29JdHNwNTRha2FkSUo2bVl6RlRVM0wyZ1JGT2xjNURjNlk3blRTTjNVajJieFFKcGcK",
      "endpoints": [
        "https://github.com/Morphy137/dummies-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
